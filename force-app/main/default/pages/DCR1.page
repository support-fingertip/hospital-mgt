  // ---- Submit summary popup ----------------------------------------------
  function summaryRow(label, actual, target, ok) {
    return (
      '<div class="sum-row"><div class="sum-label">' +
      label +
      '</div><div class="sum-actual ' +
      (ok ? "good" : "bad") +
      '">' +
      actual +
      '</div><div class="sum-target">target ' +
      target +
      "</div></div>"
    );
  }

  function openSummaryModal() {
    var t = getTargets();
    var cov = coverage();
    var calls = state.calls.length;
    var avg = callAvg();
    var issues = computeDeviations();
    el("summary-body").innerHTML =
      '<p class="summary-line">' +
      MR_NAME +
      " · " +
      state.dcrDate +
      " — review against the created targets, then continue.</p>" +
      summaryRow("Calls logged", calls, t.callsPerDay, calls >= t.callsPerDay) +
      summaryRow(
        "Doctors covered",
        cov.pct + "% (" + cov.met + "/" + cov.planned + ")",
        t.coveragePct + "%",
        cov.pct >= t.coveragePct
      ) +
      summaryRow("Call average (vials/call)", avg, t.callAvg, avg >= t.callAvg) +
      '<div class="sum-row"><div class="sum-label">Sample value</div><div class="sum-actual">' +
      inr(totalSampleValue()) +
      '</div><div class="sum-target">' +
      totalSampleQty() +
      " vial(s)</div></div>" +
      '<div class="sum-row"><div class="sum-label">Deviations from MTP</div><div class="sum-actual ' +
      (issues.length ? "bad" : "good") +
      '">' +
      (issues.length || "None") +
      '</div><div class="sum-target"></div></div>' +
      '<div class="modal-foot"><button class="btn btn-ghost" data-action="close-summary">Back</button>' +
      '<button class="btn btn-primary" data-action="confirm-submit">Continue</button></div>';
    el("summary-modal").classList.remove("hidden");
  }

  function closeSummaryModal() {
    el("summary-modal").classList.add("hidden");
  }

  // ---- Modal (pre-call + entry) ------------------------------------------
  var modalState = null;

  function openCall(doctorId, editId) {
    var existing = null;
    if (editId) {
      existing = state.calls.filter(function (c) {
        return c.id === editId;
      })[0];
    }
    var did = existing ? existing.doctorId : doctorId;
    var pc = precallFor(did);
    var sel = {};
    (existing
      ? existing.products
      : pc.productsToDetail.map(function (id) {
          return { id: id, qty: 0 };
        })
    ).forEach(function (p) {
      sel[p.id] = p.qty || 0;
    });
    var selected = {};
    (existing
      ? existing.products.map(function (p) {
          return p.id;
        })
      : pc.productsToDetail
    ).forEach(function (id) {
      selected[id] = true;
    });
    var campaignSel = {};
    (existing && existing.campaigns ? existing.campaigns : []).forEach(function (id) {
      campaignSel[id] = true;
    });
    modalState = {
      doctorId: did,
      editId: editId || null,
      // editing skips the blocking pre-call (already acknowledged once)
      step: editId ? "entry" : "precall",
      selected: selected,
      qty: sel,
      campaigns: campaignSel,
      comment: existing ? existing.comment : "",
      limitError: ""
    };
    renderModal();
    el("modal").classList.remove("hidden");
  }

  function renderModal() {
    var ms = modalState;
    var doc = DOC_BY_ID[ms.doctorId] || {
      name: ms.doctorId,
      specialty: "",
      hospital: ""
    };
    el("modal-title").textContent = doc.name;
    var stepper =
      '<div class="stepper"><div class="step ' +
      (ms.step === "precall" ? "active" : "done") +
      '">1 · Pre-call check</div><div class="step ' +
      (ms.step === "entry" ? "active" : "") +
      '">2 · Call details</div></div>';

    if (ms.step === "precall") {
      var pc = precallFor(ms.doctorId);
      var mrC = pc.mrComments.length
        ? pc.mrComments
            .map(function (t) {
              return "<p>“" + escapeHtml(t) + "”</p>";
            })
            .join("")
        : '<p class="empty-note">No prior call comments.</p>';
      var mgr = pc.managerComment
        ? "<p>“" + escapeHtml(pc.managerComment) + "”</p>"
        : '<p class="empty-note">No manager note.</p>';
      var chips = pc.productsToDetail.length
        ? '<div class="chips">' +
          pc.productsToDetail
            .map(function (id) {
              return (
                '<span class="chip">' +
                (PROD_BY_ID[id] ? PROD_BY_ID[id].name : id) +
                "</span>"
              );
            })
            .join("") +
          "</div>"
        : '<p class="empty-note">No focus products set.</p>';
      el("modal-body").innerHTML =
        stepper +
        '<div class="callout"><strong>Please check Pre-call</strong> before entering this call. Review the notes below, then acknowledge to proceed.</div>' +
        '<div class="precall-block"><div class="pb-label">' +
        doc.specialty +
        " · " +
        doc.hospital +
        "</div></div>" +
        '<div class="precall-block"><div class="pb-label">Your previous comments</div>' +
        mrC +
        "</div>" +
        '<div class="precall-block"><div class="pb-label">Manager pre-call note</div>' +
        mgr +
        "</div>" +
        '<div class="precall-block"><div class="pb-label">Products to detail</div>' +
        chips +
        "</div>" +
        '<div class="modal-foot"><button class="btn btn-ghost" data-action="close-modal">Cancel</button>' +
        '<button class="btn btn-primary" data-action="ack">Acknowledge &amp; continue</button></div>';
      return;
    }

    // entry step
    var prodRows = PRODUCTS.map(function (p) {
      var checked = ms.selected[p.id] ? "checked" : "";
      var qty = ms.qty[p.id] || 0;
      var qtyInput = ms.selected[p.id]
        ? '<input type="number" min="0" data-qty="' +
          p.id +
          '" value="' +
          qty +
          '" title="Vials / samples" />' +
          '<span class="pr-val" data-val="' +
          p.id +
          '">' +
          inr((Number(qty) || 0) * (p.price || 0)) +
          "</span>"
        : '<span class="pr-rate">' + inr(p.price || 0) + " / vial</span>";
      return (
        '<div class="prod-row"><input type="checkbox" data-prod="' +
        p.id +
        '" ' +
        checked +
        ' /><span class="pr-name">' +
        p.name +
        "</span>" +
        qtyInput +
        "</div>"
      );
    }).join("");

    // campaign marking — only campaigns this doctor belongs to
    var docCampaigns = campaignsForDoctor(ms.doctorId);
    var campaignBlock = docCampaigns.length
      ? '<div class="precall-block"><div class="pb-label">Met for marketing campaign</div>' +
        docCampaigns
          .map(function (cm) {
            return (
              '<div class="prod-row"><input type="checkbox" data-campaign="' +
              cm.id +
              '" ' +
              (ms.campaigns[cm.id] ? "checked" : "") +
              ' /><span class="pr-name">' +
              escapeHtml(cm.name) +
              "</span></div>"
            );
          })
          .join("") +
        "</div>"
      : "";

    var canSave = ms.comment && ms.comment.trim().length > 0;
    el("modal-body").innerHTML =
      stepper +
      (ms.limitError
        ? '<div class="note locked">' + escapeHtml(ms.limitError) + "</div>"
        : "") +
      '<div class="precall-block"><div class="pb-label">Products detailed (vials / value)</div>' +
      prodRows +
      "</div>" +
      campaignBlock +
      '<label class="field"><span>Call comment <span class="req">*</span> (mandatory)</span>' +
      '<textarea id="call-comment" rows="3" placeholder="What did you discuss / outcome?">' +
      escapeHtml(ms.comment) +
      "</textarea></label>" +
      (canSave
        ? ""
        : '<div class="note locked">A comment is required to save this call.</div>') +
      '<div class="modal-foot"><button class="btn btn-ghost" data-action="close-modal">Cancel</button>' +
      '<button class="btn btn-primary" data-action="save-call"' +
      (canSave ? "" : " disabled") +
      ">Save call</button></div>";
  }

  function closeModal() {
    modalState = null;
    el("modal").classList.add("hidden");
  }

  function saveCall() {
    var ms = modalState;
    if (!ms.comment || !ms.comment.trim()) return; // mandatory comment guard
    // per-day visit limit (only enforced when adding a new call)
    if (!ms.editId) {
      var perDay = getLimits().perDay;
      if (callsForDoctor(ms.doctorId) >= perDay) {
        ms.limitError =
          (DOC_BY_ID[ms.doctorId] ? DOC_BY_ID[ms.doctorId].name : "This doctor") +
          " is already logged " +
          perDay +
          " time(s) today (per-day visit limit).";
        renderModal();
        return;
      }
    }
    var products = PRODUCTS.filter(function (p) {
      return ms.selected[p.id];
    }).map(function (p) {
      var qty = Number(ms.qty[p.id]) || 0;
      return { id: p.id, qty: qty, value: qty * (p.price || 0) };
    });
    var campaigns = Object.keys(ms.campaigns || {}).filter(function (id) {
      return ms.campaigns[id];
    });
    var doc = DOC_BY_ID[ms.doctorId];
    var plannedSet = {};
    state.planToday.forEach(function (id) {
      plannedSet[id] = true;
    });
    if (ms.editId) {
      state.calls.forEach(function (c) {
        if (c.id === ms.editId) {
          c.products = products;
          c.comment = ms.comment.trim();
          c.campaigns = campaigns;
          c.sampleGiven = products.some(function (p) {
            return p.qty > 0;
          });
        }
      });
    } else {
      state.calls.push({
        id: uid(),
        doctorId: ms.doctorId,
        hospitalId: doc.hospital,
        planned: !!plannedSet[ms.doctorId],
        products: products,
        comment: ms.comment.trim(),
        campaigns: campaigns,
        sampleGiven: products.some(function (p) {
          return p.qty > 0;
        }),
        precallChecked: true
      });
    }
    afterEdit();
    closeModal();
    render();
  }

  // Editing the DCR after a decision reopens it as Draft.
  function afterEdit() {
    if (state.dcrStatus === "Rejected" || state.dcrStatus === "Logged") {
      state.dcrStatus = "Draft";
      state.deviation.status = "None";
    }
  }

  // ---- Submit / approval --------------------------------------------------
  // First click shows the summary popup (targets vs actuals); Continue commits.
  function submitDcr() {
    if (!state.calls.length || !allCommented()) {
      render();
      return;
    }
    openSummaryModal();
  }

  function doSubmit() {
    closeSummaryModal();
    if (!state.calls.length || !allCommented()) {
      render();
      return;
    }
    var issues = computeDeviations();
    if (!issues.length) {
      state.dcrStatus = "Logged";
      state.deviation = { type: "", reason: "", status: "None", decidedBy: "" };
      render();
      return;
    }
    if (!state.deviation.type) state.deviation.type = issues[0].type;
    if (!state.deviation.reason || !state.deviation.reason.trim()) {
      // need a reason first
      render();
      var ta = el("dev-reason");
      if (ta) ta.focus();
      return;
    }
    state.deviation.status = "Pending";
    state.dcrStatus = "PendingApproval";
    render();
  }

  function decide(approve) {
    state.deviation.status = approve ? "Approved" : "Rejected";
    state.deviation.decidedBy = RM_NAME;
    state.dcrStatus = approve ? "Logged" : "Rejected";
    render();
  }

  // ---- Events -------------------------------------------------------------
  function onClick(e) {
    var t = e.target.closest("[data-action]");
    if (!t) {
      if (e.target.getAttribute && e.target.getAttribute("data-close"))
        closeModal();
      return;
    }
    var a = t.getAttribute("data-action");
    if (a === "add") {
      openCall(t.getAttribute("data-doc"));
    } else if (a === "add-selected") {
      var sel = el("add-doc");
      if (sel && sel.value) openCall(sel.value);
    } else if (a === "edit") {
      openCall(null, t.getAttribute("data-id"));
    } else if (a === "remove") {
      var id = t.getAttribute("data-id");
      state.calls = state.calls.filter(function (c) {
        return c.id !== id;
      });
      afterEdit();
      render();
    } else if (a === "ack") {
      modalState.step = "entry";
      renderModal();
    } else if (a === "save-call") {
      saveCall();
    } else if (a === "close-modal") {
      closeModal();
    } else if (a === "approve") {
      decide(true);
    } else if (a === "reject") {
      decide(false);
    } else if (a === "close-summary") {
      closeSummaryModal();
    } else if (a === "confirm-submit") {
      doSubmit();
    } else if (a === "save-targets") {
      saveTargets();
    } else if (a === "save-campaign") {
      saveCampaign();
    }
  }

  function saveTargets() {
    var calls = parseInt((el("tg-calls") || {}).value, 10);
    var cov = parseInt((el("tg-cov") || {}).value, 10);
    var avg = parseFloat((el("tg-avg") || {}).value);
    saveShared(TARGETS_KEY, {
      callsPerDay: isNaN(calls) ? getTargets().callsPerDay : calls,
      coveragePct: isNaN(cov) ? getTargets().coveragePct : cov,
      callAvg: isNaN(avg) ? getTargets().callAvg : avg
    });
    render();
  }

  function saveCampaign() {
    var name = (el("cmp-name") || {}).value;
    if (!name || !name.trim()) {
      el("cmp-name").focus();
      return;
    }
    var docIds = [];
    Array.prototype.forEach.call(
      document.querySelectorAll("[data-newcamp-doc]:checked"),
      function (cb) {
        docIds.push(cb.getAttribute("data-newcamp-doc"));
      }
    );
    var list = getCampaigns();
    list.push({
      id: "CMP" + Date.now(),
      name: name.trim(),
      from: (el("cmp-from") || {}).value || "",
      to: (el("cmp-to") || {}).value || "",
      doctorIds: docIds
    });
    saveShared(CAMPAIGNS_KEY, list);
    render();
  }

  function onInput(e) {
    var tgt = e.target;
    if (tgt.id === "call-comment" && modalState) {
      var wasEmpty = !modalState.comment || !modalState.comment.trim();
      modalState.comment = tgt.value;
      var nowEmpty = !tgt.value || !tgt.value.trim();
      if (wasEmpty !== nowEmpty) {
        var pos = tgt.selectionStart;
        renderModal();
        var ta = el("call-comment");
        if (ta) {
          ta.focus();
          try {
            ta.setSelectionRange(pos, pos);
          } catch (err) {
            /* ignore */
          }
        }
      }
    } else if (tgt.matches && tgt.matches("input[data-qty]") && modalState) {
      onQtyInput(tgt);
    } else if (tgt.id === "dev-reason") {
      state.deviation.reason = tgt.value;
    } else if (tgt.id === "dev-type") {
      state.deviation.type = tgt.value;
    }
  }

  function onChange(e) {
    var tgt = e.target;
    if (tgt.id === "lim-day" || tgt.id === "lim-month") {
      var lim = getLimits();
      var v = parseInt(tgt.value, 10);
      if (!isNaN(v) && v >= 1) {
        if (tgt.id === "lim-day") lim.perDay = v;
        else lim.perMonth = v;
        saveShared(LIMITS_KEY, lim);
        render();
      }
      return;
    }
    if (!modalState) return;
    if (tgt.matches && tgt.matches('input[type="checkbox"][data-prod]')) {
      modalState.selected[tgt.getAttribute("data-prod")] = tgt.checked;
      renderModal();
    } else if (tgt.matches && tgt.matches('input[type="checkbox"][data-campaign]')) {
      modalState.campaigns[tgt.getAttribute("data-campaign")] = tgt.checked;
    }
  }

  // live-update the qty value (₹) without re-rendering (keeps focus in the input)
  function onQtyInput(tgt) {
    var pid = tgt.getAttribute("data-qty");
    modalState.qty[pid] = tgt.value;
    var span = document.querySelector('[data-val="' + pid + '"]');
    if (span) {
      var prod = PROD_BY_ID[pid];
      span.textContent = inr((Number(tgt.value) || 0) * (prod ? prod.price || 0 : 0));
    }
  }

  function init() {
    state = load() || defaultState();
    if (!state.deviation)
      state.deviation = { type: "", reason: "", status: "None", decidedBy: "" };

    el("dcr-date").addEventListener("change", function (e) {
      if (e.target.value) {
        state.dcrDate = e.target.value;
        render();
      }
    });
    el("role").addEventListener("change", function (e) {
      state.role = e.target.value;
      render();
    });
    el("reset-btn").addEventListener("click", function () {
      state = defaultState();
      render();
    });
    document.addEventListener("click", function (e) {
      if (e.target.id === "submit-btn") {
        submitDcr();
        return;
      }
      onClick(e);
    });
    document.addEventListener("input", onInput);
    document.addEventListener("change", onChange);

    render();
  }

  document.addEventListener("DOMContentLoaded", init);
})();
</script>
</body>
</html>

</apex:page>